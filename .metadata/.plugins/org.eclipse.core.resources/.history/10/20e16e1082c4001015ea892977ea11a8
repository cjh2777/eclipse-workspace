package lms;

public class CollegeItem {
    public final int id;
    public final String name;
    public final String file;

    public CollegeItem(int id, String name, String file) {
        this.id = id;
        this.name = name;
        this.file = file;
    }

    @Override
    public String toString() {
        return name;
    }
}
