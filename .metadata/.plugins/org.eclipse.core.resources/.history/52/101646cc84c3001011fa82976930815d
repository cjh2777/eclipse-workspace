package lms;

import javax.swing.*;
import javax.swing.border.TitledBorder;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.HashSet;
import java.util.Set;
import java.io.*;
import java.nio.charset.StandardCharsets;


public class LView extends JFrame {
    /**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	private JPanel grid;
    private JPanel[] cells;
    private LMiridamgi miridamgi;
    private SelectionPanel selectionPanel;
    private DefaultListModel<String> finalModel;
    private JList<String> finalList;
    private Set<String> finalCodes;

    public LView() {
        super("수강신청 메인화면");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(980, 640);
        setLocationRelativeTo(null);

        finalModel = new DefaultListModel<>();
        finalList = new JList<>(finalModel);
        finalList.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        finalCodes = new HashSet<>();

        grid = new JPanel(new GridLayout(1, 3, 8, 8));
        grid.setBorder(BorderFactory.createEmptyBorder(8, 8, 8, 8));
        cells = new JPanel[3];
        for (int i = 0; i < 3; i++) {
            cells[i] = createCell(i);
            grid.add(cells[i]);
        }
        add(grid);

        miridamgi.getAddButton().addActionListener(e -> {
            int row = selectionPanel.getTable().getSelectedRow();
            if (row == -1) {
                JOptionPane.showMessageDialog(LView.this, "강좌를 선택하세요.", "알림", JOptionPane.WARNING_MESSAGE);
            } else {
                String code = selectionPanel.getTable().getValueAt(row, 0).toString();
                String name = selectionPanel.getTable().getValueAt(row, 1).toString();
                miridamgi.addCourse(code, name);
            }
        });
    }

    public void initialize() {}

    private JPanel createCell(int i) {
        JPanel p = new JPanel(new BorderLayout());
        String title;
        if (i == 0) title = "강좌 목록";
        else if (i == 1) title = "장바구니";
        else title = "신청한 강의";
        p.setBorder(BorderFactory.createTitledBorder(
                BorderFactory.createLineBorder(new Color(200, 200, 200)),
                title, TitledBorder.LEFT, TitledBorder.TOP));

        if (i == 0) {
            selectionPanel = new SelectionPanel();
            p.add(selectionPanel, BorderLayout.CENTER);
        } else if (i == 1) {
            miridamgi = new LMiridamgi(finalList, finalModel, finalCodes);
            p.add(miridamgi, BorderLayout.CENTER);
        } else {
            JScrollPane scroll = new JScrollPane(finalList);
            p.add(scroll, BorderLayout.CENTER);
        }
        return p;
    }

    static class SelectionPanel extends JPanel {

        private static final long serialVersionUID = 1L;

        private final JTable table;
        private final DefaultTableModel model;

       
        private final JComboBox<RootItem> campusBox;
        private final JComboBox<CollegeItem> collegeBox;
        private final JComboBox<DeptItem> deptBox;

        SelectionPanel() {
            setLayout(new BorderLayout(8, 8));


            JPanel top = new JPanel(new GridLayout(2, 3, 5, 5));

            top.add(new JLabel("캠퍼스", SwingConstants.CENTER));
            top.add(new JLabel("대학", SwingConstants.CENTER));
            top.add(new JLabel("학과", SwingConstants.CENTER));

            campusBox = new JComboBox<>();
            collegeBox = new JComboBox<>();
            deptBox = new JComboBox<>();

            top.add(campusBox);
            top.add(collegeBox);
            top.add(deptBox);

            add(top, BorderLayout.NORTH);


            String[] cols = {"과목코드", "과목명", "시간", "강사", "학점", "정원"};
            model = new DefaultTableModel(cols, 0) {
                @Override
                public boolean isCellEditable(int row, int col) {
                    return false;
                }
            };
            table = new JTable(model);
            table.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
            add(new JScrollPane(table), BorderLayout.CENTER);
            
            campusBox.addActionListener(e -> loadCollege());
            collegeBox.addActionListener(e -> loadDept());
            deptBox.addActionListener(e -> loadLecture());

           
            loadRoot();
        }

      
        private void loadRoot() {
            campusBox.removeAllItems();

            try (BufferedReader br = new BufferedReader(new InputStreamReader(
                    new FileInputStream("root.txt"), StandardCharsets.UTF_8))) {

                String line;
                while ((line = br.readLine()) != null) {
                    String[] s = line.trim().split("\\s+");
                    if (s.length >= 3) {
                        campusBox.addItem(new RootItem(
                                Integer.parseInt(s[0]),
                                s[1],
                                s[2] + ".txt"
                        ));
                    }
                }
            } catch (Exception ex) {
                ex.printStackTrace();
            }

            if (campusBox.getItemCount() > 0) {
                campusBox.setSelectedIndex(0);
                loadCollege();
            }
        }

        
        private void loadCollege() {
            collegeBox.removeAllItems();
            deptBox.removeAllItems();
            model.setRowCount(0);

            RootItem root = (RootItem) campusBox.getSelectedItem();
            if (root == null) return;

            try (BufferedReader br = new BufferedReader(new InputStreamReader(
                    new FileInputStream(root.file), StandardCharsets.UTF_8))) {

                String line;
                while ((line = br.readLine()) != null) {
                    String[] s = line.trim().split("\\s+");
                    if (s.length >= 3) {
                        collegeBox.addItem(new CollegeItem(
                                Integer.parseInt(s[0]),
                                s[1],
                                s[2] + ".txt"
                        ));
                    }
                }
            } catch (Exception ex) {
                ex.printStackTrace();
            }

            if (collegeBox.getItemCount() > 0) {
                collegeBox.setSelectedIndex(0);
                loadDept();
            }
        }

      
        private void loadDept() {
            deptBox.removeAllItems();
            model.setRowCount(0);

            CollegeItem col = (CollegeItem) collegeBox.getSelectedItem();
            if (col == null) return;

            try (BufferedReader br = new BufferedReader(new InputStreamReader(
                    new FileInputStream(col.file), StandardCharsets.UTF_8))) {

                String line;
                while ((line = br.readLine()) != null) {
                    String[] s = line.trim().split("\\s+");
                    if (s.length >= 3) {
                        deptBox.addItem(new DeptItem(
                                Integer.parseInt(s[0]),
                                s[1],
                                s[2] + ".txt"
                        ));
                    }
                }
            } catch (Exception ex) {
                ex.printStackTrace();
            }

            if (deptBox.getItemCount() > 0) {
                deptBox.setSelectedIndex(0);
                loadLecture();
            }
        }

       
        private void loadLecture() {
            model.setRowCount(0);

            DeptItem dept = (DeptItem) deptBox.getSelectedItem();
            if (dept == null) return;

            try (BufferedReader br = new BufferedReader(new InputStreamReader(
                    new FileInputStream(dept.file), StandardCharsets.UTF_8))) {

                String line;
                while ((line = br.readLine()) != null) {
                    String[] s = line.trim().split("\\s+");

                    if (s.length >= 5) {
                        String code = s[0];
                        String name = s[1];
                        String inst = s[2];
                        int credit = Integer.parseInt(s[3]);
                        String time = s[4];

                        model.addRow(new Object[]{
                                code, name, time, inst,
                                String.valueOf(credit), "50"
                        });
                    }
                }
            } catch (Exception ex) {
                ex.printStackTrace();
            }
        }

        public JTable getTable() {
            return table;
        }
    }


}
