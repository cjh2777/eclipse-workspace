        setLayout(new BorderLayout());
        setBorder(new EmptyBorder(16,16,16,16));

        JLabel welcome = new JLabel();
        welcome.setFont(welcome.getFont().deriveFont(Font.BOLD, 16f));
        add(welcome, BorderLayout.NORTH);

        JTextArea info = new JTextArea();
        info.setEditable(false);
        info.setLineWrap(true);
        info.setWrapStyleWord(true);
        info.setText(
            "여기는 수강신청 메인 화면 예시입니다.\n" +
            "- 상단 환영 문구 옆에 [로그아웃] 버튼\n" +
            "- 아래 영역에 과목 목록, 장바구니, 신청/삭제 버튼 등을 배치하세요.\n" +
            "\n연동 가이드:\n" +
            "AuthService.getCurrentUser()로 로그인 사용자 정보를 가져와 권한 체크 및 이름 표시에 이용하세요.\n"
        );
        add(new JScrollPane(info), BorderLayout.CENTER);

        JButton btnLogout = new JButton("로그아웃");
        JPanel topRight = new JPanel(new FlowLayout(FlowLayout.RIGHT));
        topRight.add(btnLogout);
        add(topRight, BorderLayout.SOUTH);

        // 로그인 사용자 이름 표시
        auth.getCurrentUser().ifPresent(u -> welcome.setText("환영합니다, " + u.name + "(" + u.username + ") 님"));

        btnLogout.addActionListener(e -> {
            auth.logout();
            JOptionPane.showMessageDialog(this, "로그아웃되었습니다.");
            frame.showLogin();
        });
    }
}
